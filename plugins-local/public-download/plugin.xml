<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    id="com.rptes.publicdownload"
    version="1.0.0">
    <name>PublicDownload</name>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="PublicDownload">
                <param name="android-package" value="com.rptes.publicdownload.PublicDownload" />
            </feature>
        </config-file>

        <source-file src="src/android/PublicDownload.java"
            target-dir="app/src/main/java/com/rptes/publicdownload" />
    </platform>
</plugin>